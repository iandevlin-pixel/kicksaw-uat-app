<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>63.0</apiVersion>
    <environments>Default</environments>
    <interviewLabel>Test Run Case | After Save | Set As Latest Test Run Case {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Test Run Case | After Save | Set As Latest Test Run Case</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Uncheck_Is_Latest_Checkbox_on_Older_Test_Run_Cases</name>
        <label>Uncheck Is Latest? Checkbox on Older Test Run Cases</label>
        <locationX>176</locationX>
        <locationY>431</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>TestCase__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.TestCase__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Tester_Id__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Tester_Id__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Id</field>
            <operator>NotEqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Is_Latest__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <inputAssignments>
            <field>Is_Latest__c</field>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </inputAssignments>
        <object>TestRunCase__c</object>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Triggering_Test_Run</name>
        <label>Update Triggering Test Run</label>
        <locationX>176</locationX>
        <locationY>323</locationY>
        <connector>
            <targetReference>Uncheck_Is_Latest_Checkbox_on_Older_Test_Run_Cases</targetReference>
        </connector>
        <inputAssignments>
            <field>Is_Latest__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Update_Triggering_Test_Run</targetReference>
        </connector>
        <object>TestRunCase__c</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
