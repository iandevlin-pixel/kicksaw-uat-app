<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <decisions>
        <name>Can_Request</name>
        <label>Can request?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Request_Jira</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>OK</defaultConnectorLabel>
        <rules>
            <name>Blocked</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>fxBlockMsg</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Blocked_Screen</targetReference>
            </connector>
            <label>Blocked</label>
        </rules>
    </decisions>
    <description>Quick action on UAT Feedback. Checks the item is ready, marks Needs Jira Ticket / Jira Requested At / Jira Sync Status = Requested, and publishes UAT_Work_Request__e (Create Jira).</description>
    <environments>Default</environments>
    <formulas>
        <name>fxBlockMsg</name>
        <dataType>String</dataType>
        <expression>IF(NOT({!$Permission.UAT_Kicksaw_Reviewer}), &quot;Only Kicksaw reviewers can request a Jira ticket.&quot;,
IF(NOT(OR(TEXT({!Get_Item.Kicksaw_Determination__c}) = &quot;Bug&quot;, TEXT({!Get_Item.Kicksaw_Determination__c}) = &quot;Enhancement&quot;)), &quot;Set Kicksaw Determination to Bug or Enhancement before requesting a Jira ticket.&quot;,
IF(LEN({!Get_Item.Resolution__c}) = 0, &quot;Write a Final Resolution before requesting a Jira ticket.&quot;,
IF(NOT(ISBLANK({!Get_Item.JIRA_Ticket_URL__c})), &quot;This item already has a UAT Build Task (Jira): &quot; &amp; {!Get_Item.JIRA_Ticket_URL__c},
IF(TEXT({!Get_Item.Jira_Sync_Status__c}) = &quot;Requested&quot;, &quot;A Jira ticket has already been requested for this item and is waiting for triage.&quot;, &quot;&quot;)))))</expression>
    </formulas>
    <formulas>
        <name>fxDoneMsg</name>
        <dataType>String</dataType>
        <expression>IF({!varInstant}, &quot;Requested. The Jira ticket will be created within a few minutes.&quot;, &quot;Requested. It will be created on the next scheduled run.&quot;)</expression>
    </formulas>
    <interviewLabel>UAT - Create Jira Ticket {!$Flow.CurrentDateTime}</interviewLabel>
    <label>UAT - Create Jira Ticket</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordCreates>
        <name>Publish_Create_Jira</name>
        <label>Publish UAT Work Request</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Done_Screen</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Error_Screen</targetReference>
        </faultConnector>
        <inputAssignments>
            <field>Action__c</field>
            <value>
                <stringValue>Create Jira</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Item_Name__c</field>
            <value>
                <elementReference>Get_Item.Name</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>UAT_Feedback_Id__c</field>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </inputAssignments>
        <object>UAT_Work_Request__e</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordLookups>
        <name>Get_Item</name>
        <label>Get UAT item</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Setting</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>UAT_Feedback__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Setting</name>
        <label>Get UAT Setting</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Can_Request</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Default</stringValue>
            </value>
        </filters>
        <object>Kicksaw_UAT_Setting__mdt</object>
        <outputAssignments>
            <assignToReference>varInstant</assignToReference>
            <field>Instant_Runs_Enabled__c</field>
        </outputAssignments>
    </recordLookups>
    <recordUpdates>
        <name>Request_Jira</name>
        <label>Mark Jira requested</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Publish_Create_Jira</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Error_Screen</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Jira_Requested_At__c</field>
            <value>
                <elementReference>$Flow.CurrentDateTime</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Jira_Sync_Status__c</field>
            <value>
                <stringValue>Requested</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Needs_Jira_Ticket__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <object>UAT_Feedback__c</object>
    </recordUpdates>
    <screens>
        <name>Blocked_Screen</name>
        <label>Cannot request yet</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>dspBlocked</name>
            <fieldText>&lt;p&gt;&lt;b&gt;Jira ticket not requested.&lt;/b&gt;&lt;/p&gt;&lt;p&gt;{!fxBlockMsg}&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Done_Screen</name>
        <label>Requested</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>dspDone</name>
            <fieldText>&lt;p&gt;{!fxDoneMsg}&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Error_Screen</name>
        <label>Error</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>dspError</name>
            <fieldText>&lt;p&gt;The Jira request could not be saved.&lt;/p&gt;&lt;p&gt;{!$Flow.FaultMessage}&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Item</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
