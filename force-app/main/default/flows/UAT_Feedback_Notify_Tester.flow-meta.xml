    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Setting</targetReference>
        </connector>
        <filterFormula>OR(AND(ISCHANGED({!$Record.Kicksaw_Determination__c}), ISPICKVAL({!$Record.Kicksaw_Determination__c}, &quot;Needs Info&quot;)), AND(ISCHANGED({!$Record.Status__c}), OR(ISPICKVAL({!$Record.Status__c}, &quot;Ready for Retest&quot;), ISPICKVAL({!$Record.Status__c}, &quot;Not a Bug&quot;), ISPICKVAL({!$Record.Status__c}, &quot;Duplicate&quot;), ISPICKVAL({!$Record.Status__c}, &quot;Won&apos;t Do&quot;))))</filterFormula>
