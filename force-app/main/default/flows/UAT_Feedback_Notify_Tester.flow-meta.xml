    <description>Notifies the tester (Submitted By, else Created By) when Kicksaw marks an item Needs Info, Ready for Retest, or closes it as Not a Bug / Duplicate / Won&apos;t Do. Channel comes from Kicksaw_UAT_Setting__mdt.Default (blank = App).</description>
    <environments>Default</environments>
    <formulas>
        <name>fxBody</name>
        <dataType>String</dataType>
        <expression>IF({!fxIsNeedsInfo}, &quot;Kicksaw needs more information. Open the item and see Final Resolution for the question.&quot;, IF({!fxStatus} = &quot;Ready for Retest&quot;, &quot;A fix is ready. Please retest and update the item.&quot;, &quot;This item was closed as &quot; &amp; {!fxStatus} &amp; &quot;. See Final Resolution.&quot;))</expression>
    </formulas>
    <formulas>
        <name>fxEmailBody</name>
        <dataType>String</dataType>
        <expression>{!fxBody} &amp; BR() &amp; BR() &amp; &quot;Open the item: &quot; &amp; {!fxRecordLink}</expression>
    </formulas>
    <formulas>
        <name>fxIsNeedsInfo</name>
        <dataType>Boolean</dataType>
        <expression>AND(TEXT({!$Record.Kicksaw_Determination__c}) = &quot;Needs Info&quot;, TEXT({!$Record__Prior.Kicksaw_Determination__c}) &lt;&gt; &quot;Needs Info&quot;)</expression>
    </formulas>
    <formulas>
        <name>fxRecipient</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!$Record.SubmittedBy__c}), {!$Record.CreatedById}, {!$Record.SubmittedBy__c})</expression>
    </formulas>
    <formulas>
        <description>The tester's email: Submitted By, else the creator.</description>
        <name>fxRecipientEmail</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!$Record.SubmittedBy__c}), {!$Record.CreatedBy.Email}, {!$Record.SubmittedBy__r.Email})</expression>
    </formulas>
    <formulas>
        <name>fxRecordLink</name>
        <dataType>String</dataType>
        <expression>LEFT({!$Api.Partner_Server_URL_620}, FIND(&quot;/services&quot;, {!$Api.Partner_Server_URL_620})) &amp; {!$Record.Id}</expression>
    </formulas>
    <formulas>
        <name>fxSendApp</name>
        <dataType>Boolean</dataType>
        <expression>OR(ISBLANK({!varChannel}), {!varChannel} = &quot;App&quot;, {!varChannel} = &quot;Both&quot;)</expression>
    </formulas>
    <formulas>
        <name>fxSendEmail</name>
        <dataType>Boolean</dataType>
        <expression>OR({!varChannel} = &quot;Email&quot;, {!varChannel} = &quot;Both&quot;)</expression>
    </formulas>
    <formulas>
        <name>fxStatus</name>
        <dataType>String</dataType>
        <expression>TEXT({!$Record.Status__c})</expression>
    </formulas>
    <formulas>
        <name>fxTitle</name>
        <dataType>String</dataType>
        <expression>&quot;UAT item &quot; &amp; {!$Record.Name} &amp; &quot;: &quot; &amp; IF({!fxIsNeedsInfo}, &quot;Needs Info&quot;, {!fxStatus})</expression>
    </formulas>
