<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <decisions>
        <name>Still_Needs_Triage</name>
        <label>Still needs triage?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Already triaged</defaultConnectorLabel>
        <rules>
            <name>Needs_Triage</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Has_Claude_Proposal__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Triage_Requested_At__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Stamp_Triage_Requested</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>5 minutes after a new item of any type (Bug, Enhancement, Training) is created (so the tester can finish attaching files), stamps Triage Requested At and publishes UAT_Work_Request__e (Triage). Skips records created by the integration user.</description>
    <environments>Default</environments>
    <interviewLabel>UAT Feedback - Request Triage {!$Flow.CurrentDateTime}</interviewLabel>
    <label>UAT Feedback - Request Triage</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Publish_Triage</name>
        <label>Publish UAT Work Request</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Action__c</field>
            <value>
                <stringValue>Triage</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Item_Name__c</field>
            <value>
                <elementReference>$Record.Name</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>UAT_Feedback_Id__c</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <object>UAT_Work_Request__e</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordUpdates>
        <name>Stamp_Triage_Requested</name>
        <label>Stamp Triage Requested At</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Publish_Triage</targetReference>
        </connector>
        <inputAssignments>
            <field>Triage_Requested_At__c</field>
            <value>
                <elementReference>$Flow.CurrentDateTime</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterFormula>NOT({!$Permission.UAT_Integration})</filterFormula>
        <object>UAT_Feedback__c</object>
        <recordTriggerType>Create</recordTriggerType>
        <scheduledPaths>
            <name>X5_min_after_create</name>
            <connector>
                <targetReference>Still_Needs_Triage</targetReference>
            </connector>
            <label>5 min after create</label>
            <offsetNumber>5</offsetNumber>
            <offsetUnit>Minutes</offsetUnit>
            <recordField>CreatedDate</recordField>
            <timeSource>RecordField</timeSource>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
