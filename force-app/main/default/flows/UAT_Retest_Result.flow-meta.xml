<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <choices>
        <name>choPassed</name>
        <choiceText>It works now</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Passed</stringValue>
        </value>
    </choices>
    <choices>
        <name>choFailed</name>
        <choiceText>It is still wrong</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Failed</stringValue>
        </value>
    </choices>
    <decisions>
        <name>Can_Retest</name>
        <label>Can record a retest?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Retest_Screen</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>OK</defaultConnectorLabel>
        <rules>
            <name>Blocked</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>fxBlockMsg</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Blocked_Screen</targetReference>
            </connector>
            <label>Blocked</label>
        </rules>
    </decisions>
    <decisions>
        <name>Which_Result</name>
        <label>Which result?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Still_Wrong_Screen</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Still wrong</defaultConnectorLabel>
        <rules>
            <name>Passed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>rbResult</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Passed</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Resolve_Item</targetReference>
            </connector>
            <label>Passed</label>
        </rules>
    </decisions>
    <description>Quick action on UAT Feedback for the tester (or a Kicksaw reviewer) when an item is Ready for Retest. Passed: Status = Resolved with a Final Resolution line. Still wrong: the same item is reopened (Status = In Progress, Jira Sync Status = Reopen Requested, Retest Failed At = now) and the tester's note is added to Retest Notes; the next skill run reopens the Jira ticket. Runs in system context because testers cannot edit Final Resolution or the Jira fields; the flow itself checks who is running it.</description>
    <environments>Default</environments>
    <formulas>
        <name>fxBlockMsg</name>
        <dataType>String</dataType>
        <expression>IF(TEXT({!Get_Item.Status__c}) &lt;&gt; &quot;Ready for Retest&quot;, &quot;This item is not ready for retest. Its status is &quot; &amp; TEXT({!Get_Item.Status__c}) &amp; &quot;.&quot;,
IF(NOT(OR({!$Permission.UAT_Kicksaw_Reviewer}, CASESAFEID({!Get_Item.SubmittedBy__c}) = CASESAFEID({!$User.Id}), CASESAFEID({!Get_Item.CreatedById}) = CASESAFEID({!$User.Id}))), &quot;Only the tester who submitted this item, or a Kicksaw reviewer, can record its retest.&quot;, &quot;&quot;))</expression>
    </formulas>
    <formulas>
        <name>fxStamp</name>
        <dataType>String</dataType>
        <expression>TEXT(TODAY()) &amp; &quot; &quot; &amp; {!$User.FirstName} &amp; &quot; &quot; &amp; {!$User.LastName}</expression>
    </formulas>
    <formulas>
        <name>fxPassedResolution</name>
        <dataType>String</dataType>
        <expression>IF(LEN({!Get_Item.Resolution__c}) = 0, &quot;&quot;, {!Get_Item.Resolution__c} &amp; &quot;&lt;br&gt;&quot;) &amp; &quot;Retest passed (&quot; &amp; {!fxStamp} &amp; &quot;).&quot; &amp; IF(ISBLANK({!txtNotes}), &quot;&quot;, &quot; &quot; &amp; {!txtNotes})</expression>
    </formulas>
    <formulas>
        <name>fxFailedNotes</name>
        <dataType>String</dataType>
        <expression>IF(LEN({!Get_Item.Retest_Notes__c}) = 0, &quot;&quot;, {!Get_Item.Retest_Notes__c} &amp; BR()) &amp; &quot;Retest failed (&quot; &amp; {!fxStamp} &amp; &quot;): &quot; &amp; {!txtStillWrong}</expression>
    </formulas>
    <formulas>
        <name>fxPassedNotes</name>
        <dataType>String</dataType>
        <expression>IF(LEN({!Get_Item.Retest_Notes__c}) = 0, &quot;&quot;, {!Get_Item.Retest_Notes__c} &amp; BR()) &amp; &quot;Retest passed (&quot; &amp; {!fxStamp} &amp; &quot;).&quot; &amp; IF(ISBLANK({!txtNotes}), &quot;&quot;, &quot; &quot; &amp; {!txtNotes})</expression>
    </formulas>
    <interviewLabel>UAT - Retest Result {!$Flow.CurrentDateTime}</interviewLabel>
    <label>UAT - Retest Result</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordLookups>
        <name>Get_Item</name>
        <label>Get UAT item</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Can_Retest</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>UAT_Feedback__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Resolve_Item</name>
        <label>Close as Resolved</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Passed_Screen</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Error_Screen</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Resolution__c</field>
            <value>
                <elementReference>fxPassedResolution</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Retest_Notes__c</field>
            <value>
                <elementReference>fxPassedNotes</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status__c</field>
            <value>
                <stringValue>Resolved</stringValue>
            </value>
        </inputAssignments>
        <object>UAT_Feedback__c</object>
    </recordUpdates>
    <recordUpdates>
        <name>Reopen_Item</name>
        <label>Reopen the item</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Failed_Screen</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Error_Screen</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Jira_Sync_Status__c</field>
            <value>
                <stringValue>Reopen Requested</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Retest_Failed_At__c</field>
            <value>
                <elementReference>$Flow.CurrentDateTime</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Retest_Notes__c</field>
            <value>
                <elementReference>fxFailedNotes</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status__c</field>
            <value>
                <stringValue>In Progress</stringValue>
            </value>
        </inputAssignments>
        <object>UAT_Feedback__c</object>
    </recordUpdates>
    <runInMode>SystemModeWithoutSharing</runInMode>
    <screens>
        <name>Retest_Screen</name>
        <label>Retest Result</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Which_Result</targetReference>
        </connector>
        <fields>
            <name>dspIntro</name>
            <fieldText>&lt;p&gt;&lt;b&gt;{!Get_Item.Name}&lt;/b&gt; is ready for retest. Try the same steps again, then tell us what you found.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <fields>
            <name>rbResult</name>
            <choiceReferences>choPassed</choiceReferences>
            <choiceReferences>choFailed</choiceReferences>
            <dataType>String</dataType>
            <fieldText>What happened when you retested?</fieldText>
            <fieldType>RadioButtons</fieldType>
            <isRequired>true</isRequired>
        </fields>
        <fields>
            <name>txtNotes</name>
            <fieldText>Anything to add? (optional)</fieldText>
            <fieldType>LargeTextArea</fieldType>
            <isRequired>false</isRequired>
            <visibilityRule>
                <conditionLogic>and</conditionLogic>
                <conditions>
                    <leftValueReference>rbResult</leftValueReference>
                    <operator>EqualTo</operator>
                    <rightValue>
                        <stringValue>Passed</stringValue>
                    </rightValue>
                </conditions>
            </visibilityRule>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Still_Wrong_Screen</name>
        <label>What is still wrong?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Reopen_Item</targetReference>
        </connector>
        <fields>
            <name>txtStillWrong</name>
            <fieldText>What did you do, and what happened?</fieldText>
            <fieldType>LargeTextArea</fieldType>
            <isRequired>true</isRequired>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Passed_Screen</name>
        <label>Closed</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>dspPassed</name>
            <fieldText>&lt;p&gt;Thank you. {!Get_Item.Name} is closed as Resolved.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Failed_Screen</name>
        <label>Reopened</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>dspFailed</name>
            <fieldText>&lt;p&gt;Thank you. {!Get_Item.Name} is reopened and back with the Kicksaw team. You will be notified when it is ready to retest again.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Blocked_Screen</name>
        <label>Cannot record a retest</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>dspBlocked</name>
            <fieldText>&lt;p&gt;&lt;b&gt;Retest not recorded.&lt;/b&gt;&lt;/p&gt;&lt;p&gt;{!fxBlockMsg}&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Error_Screen</name>
        <label>Error</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>dspError</name>
            <fieldText>&lt;p&gt;The retest result could not be saved.&lt;/p&gt;&lt;p&gt;{!$Flow.FaultMessage}&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Item</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
