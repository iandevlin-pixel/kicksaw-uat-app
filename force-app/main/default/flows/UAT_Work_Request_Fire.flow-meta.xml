<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Fire_Routine</name>
        <label>Fire triage routine</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>ClaudeUATTriage.fireRoutine</actionName>
        <actionType>externalService</actionType>
        <faultConnector>
            <targetReference>Is_Create_Jira</targetReference>
        </faultConnector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>routineId</name>
            <value>
                <elementReference>varRoutineId</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>body</name>
            <value>
                <elementReference>varBody</elementReference>
            </value>
        </inputParameters>
        <nameSegment>ClaudeUATTriage.fireRoutine</nameSegment>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </actionCalls>
    <apiVersion>62.0</apiVersion>
    <assignments>
        <name>Build_Body</name>
        <label>Build request body</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varBody.text</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>fxText</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Fire_Routine</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Instant_On</name>
        <label>Instant runs on?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Off - wait for scheduled run</defaultConnectorLabel>
        <rules>
            <name>Instant_Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varInstant</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varRoutineId</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Build_Body</targetReference>
            </connector>
            <label>On</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_Create_Jira</name>
        <label>Create Jira request?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Create_Jira_Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Action__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Create Jira</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Mark_Failed</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>Subscribes to UAT_Work_Request__e. When Instant Runs Enabled is on, fires the triage routine with only the action, item number and Id. On a failed Create Jira call, marks Jira Sync Status = Failed.</description>
    <environments>Default</environments>
    <formulas>
        <name>fxText</name>
        <dataType>String</dataType>
        <expression>&quot;UAT work request: &quot; &amp; {!$Record.Action__c} &amp; &quot; for &quot; &amp; {!$Record.Item_Name__c} &amp; &quot; (&quot; &amp; {!$Record.UAT_Feedback_Id__c} &amp; &quot;)&quot;</expression>
    </formulas>
    <interviewLabel>UAT Work Request - Fire Triage Routine {!$Flow.CurrentDateTime}</interviewLabel>
    <label>UAT Work Request - Fire Triage Routine</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Setting</name>
        <label>Get UAT Setting</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Instant_On</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Default</stringValue>
            </value>
        </filters>
        <object>Kicksaw_UAT_Setting__mdt</object>
        <outputAssignments>
            <assignToReference>varInstant</assignToReference>
            <field>Instant_Runs_Enabled__c</field>
        </outputAssignments>
        <outputAssignments>
            <assignToReference>varRoutineId</assignToReference>
            <field>Routine_Trigger_Id__c</field>
        </outputAssignments>
    </recordLookups>
    <recordUpdates>
        <name>Mark_Failed</name>
        <label>Mark Jira Sync Failed</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.UAT_Feedback_Id__c</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Jira_Sync_Status__c</field>
            <value>
                <stringValue>Failed</stringValue>
            </value>
        </inputAssignments>
        <object>UAT_Feedback__c</object>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Setting</targetReference>
        </connector>
        <flowRunAsUser>TriggeringUser</flowRunAsUser>
        <object>UAT_Work_Request__e</object>
        <triggerType>PlatformEvent</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>varBody</name>
        <apexClass>ExternalService__ClaudeUATTriage_FireRequest</apexClass>
        <dataType>Apex</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varInstant</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varRoutineId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
