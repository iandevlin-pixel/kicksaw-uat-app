<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Closed_Needs_Resolution</fullName>
    <active>true</active>
    <errorConditionFormula>OR(ISPICKVAL(Status__c,&quot;Resolved&quot;),ISPICKVAL(Status__c,&quot;Not a Bug&quot;),ISPICKVAL(Status__c,&quot;Duplicate&quot;),ISPICKVAL(Status__c,&quot;Won&apos;t Do&quot;)) &amp;&amp; LEN(Resolution__c) = 0</errorConditionFormula>
    <errorDisplayField>Resolution__c</errorDisplayField>
    <errorMessage>Write a Final Resolution before closing this item.</errorMessage>
</ValidationRule>
